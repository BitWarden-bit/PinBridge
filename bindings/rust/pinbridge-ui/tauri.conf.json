{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pinbridge-ui",
  "version": "0.1.0",
  "identifier": "com.pinbridge.ui",
  "build": {
    "frontendDist": "./ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PinBridge",
        "width": 1360,
        "height": 840,
        "minWidth": 1180,
        "minHeight": 720,
        "center": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
